---
import Base from "../layouts/Base.astro";
import Window from "../components/Window.astro";
import { getSite } from "../lib/content";

const site = await getSite();
---
<Base title="Not found" activeTitle="404">
  <main class="desk single" id="desk">
    <Window id="w-404" app="kitty" title="~" active maximizable={false} heading="h1">
      <p class="prompt"><span class="u">{site.handle}@snowy-burbot</span> ~ <span class="c">cd <span id="path">this-page</span></span></p>
      <p class="err">bash: cd: no such file or directory</p>
      <p>This page doesn't exist. <a href="/">Back to the desktop</a>.</p>
    </Window>
  </main>
</Base>
