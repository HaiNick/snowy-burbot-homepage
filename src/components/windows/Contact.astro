---
import Window from "../Window.astro";
import { getLegal, getSite } from "../../lib/content";

const site = await getSite();
const legal = await getLegal();
const year = new Date().getFullYear();
---
<Window id="w-contact" app="aerc" title="compose">
  <p>{site.contact}</p>
  <div class="mail-line">
    <span class="mail" id="mail">{site.email}</span>
    <button class="copy" id="copy" type="button">copy</button>
  </div>
  <p class="legal">
    <a href="/.well-known/security.txt">security.txt</a>
    {legal.map((l) => <a href={`/${l.id}`}>{l.data.linkText}</a>)}
    <span>© {year} {site.name}</span>
  </p>
  <p class="keys"><kbd>1</kbd>-<kbd>7</kbd> focus window, <kbd>f</kbd> fullscreen, <kbd>esc</kbd> back</p>
</Window>
